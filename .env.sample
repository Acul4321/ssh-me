# PocketBase URL used by the terminal-app to query profiles
PB_BASE_URL=

# PocketBase URL baked into the web app build
VITE_PB_URL=

# PocketBase superuser — used by pocketbase/Dockerfile CMD to create the admin account
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Google OAuth — leave blank to skip auto-config (configure manually in the Admin UI instead)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App metadata (optional)
PB_APP_NAME=ssh-me
PB_APP_URL=

# SSH server runtime config (local defaults are fine for development)
SSH_HOST=
SSH_PORT=
SSH_HOST_KEY_PATH=

# PocketBase S3 backups (optional)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_FORCE_PATH_STYLE=
BACKUP_CRON=
BACKUP_CRON_MAX_KEEP=
